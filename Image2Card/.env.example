# 复制本文件为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会泄露）
# cp .env.example .env.local

# ---- VLM（OpenAI 兼容接口，真实识别所需）----
OPENAI_API_KEY="your_api_key"
OPENAI_BASE_URL="http://your-relay-host:8080"
OPENAI_MODEL="gpt-5.4"
OPENAI_WIRE_API="responses"        # 中转站若兼容 Chat Completions 可改为 "chat"
OPENAI_TIMEOUT_SECONDS="60"
OPENAI_TRUST_ENV="false"

# ---- DashScope（可选，备用识别 Provider）----
DASHSCOPE_API_KEY="your_dashscope_key"
